{
  "name": "@chinchi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "load:seed": "tsx scripts/load-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@chinchi/markdown": "workspace:*",
    "@chinchi/shared": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/websocket": "11.3.4",
    "@prometheus-io/client": "0.16.1",
    "@smithy/signature-v4": "5.7.4",
    "archiver": "8.0.0",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "htmlparser2": "12.0.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "livekit-server-sdk": "2.19.1",
    "nodemailer": "10.1.0",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "undici": "8.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chinchi/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/archiver": "8.0.0",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "testcontainers": "12.2.1",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "ws": "8.22.0"
  }
}
