# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Snowflake worker id (0-1023), unique per server process
WORKER_ID=0
# PostgreSQL connection string (postgres:// or postgresql://)
DATABASE_URL=postgres://chinchi:chinchi@localhost:5432/chinchi
# Valkey/Redis connection string (redis:// or rediss://)
REDIS_URL=redis://localhost:6379
# on | off — disable only for local load/e2e testing
RATE_LIMIT=on
# Browser origins allowed to call the API with cookies (comma-separated, CSRF protection)
WEB_ORIGINS=http://localhost:5173
# Session lifetime in days; extended on activity
SESSION_TTL_DAYS=30
# Public URL of the web app, used in emailed links
PUBLIC_URL=http://localhost:5173
# SMTP server for outgoing mail; without it emails are only logged. Dev: Mailpit (UI on :8025)
SMTP_URL=smtp://127.0.0.1:2525
MAIL_FROM=Chinchi <no-reply@localhost>
# Instance name shown to users
INSTANCE_NAME=Chinchi
# open | invite | closed — the default; admins can change it in the admin panel (stored in the DB)
REGISTRATION_MODE=open
# on | off — default for the admin setting: a confirmed email before servers, invites, DMs, friends
REQUIRE_VERIFIED_EMAIL=off
# Registering with this email and confirming it makes the account the instance admin (without
# SMTP the link is logged as FIRST ADMIN LINK); unset = the first account
# INITIAL_ADMIN_EMAIL=admin@example.com
# Reverse proxies allowed to set X-Forwarded-For: false | true | hop count | comma-separated IPs/CIDRs
# Behind one reverse proxy (Caddy, nginx): TRUST_PROXY=1 — exactly one hop, whatever its address.
# `true` believes the leftmost entry, which clients control unless the proxy strips the header.
TRUST_PROXY=false
# 64 hex characters (openssl rand -hex 32): encrypts two-factor secrets in the database.
# Optional in development; the production compose file requires it.
# SECRETS_KEY=
# S3-compatible object storage for file uploads; without S3_ENDPOINT uploads are disabled.
# Dev: RustFS from deploy/docker-compose.dev.yml. The bucket and its CORS rules are created at start.
S3_ENDPOINT=http://localhost:9000
# Address browsers use for presigned URLs, if different from S3_ENDPOINT (e.g. https://files.example.com)
# S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_BUCKET=chinchi
S3_ACCESS_KEY=chinchi-dev
S3_SECRET_KEY=chinchi-dev-secret
# on for RustFS/MinIO path-style URLs, off for virtual-hosted buckets (AWS)
S3_PATH_STYLE=on
# Encryption at rest by the storage's KMS (the dev RustFS has one); the server creates the key.
# S3_ENCRYPTION=on
# on | off — server-side link previews (fetches pages users link to, never private addresses)
LINK_PREVIEWS=on
# Per-file limit in bytes (max 1 GiB)
UPLOAD_MAX_BYTES=26214400
# LiveKit for voice and video; without LIVEKIT_URL voice is off.
# LIVEKIT_URL is what browsers connect to (ws:// in dev, wss:// in production).
LIVEKIT_URL=ws://localhost:7880
# How the server reaches LiveKit, if different (e.g. http://livekit:7880 inside docker compose)
# LIVEKIT_API_URL=
LIVEKIT_API_KEY=devkey
# At least 32 characters; must match LIVEKIT_KEYS of the LiveKit server
LIVEKIT_API_SECRET=chinchi-dev-livekit-secret-0123456789
