# Settings for docker-compose.yml: save as .env next to it and fill in every value marked
# "required". Generate secrets with: openssl rand -hex 32
# (hex only: base64 contains "/" and "+", which break the connection URLs built from them).

# The Chinchi release to run; upgrading is changing this and running `docker compose up -d`.
# Unset, the version the compose file was released with is used.
CHINCHI_VERSION=

# Required: the DNS name pointing at this server (A/AAAA records). It serves the app, the API,
# files (under /chinchi/) and voice signalling (under /livekit/), with one HTTPS certificate.
CHINCHI_DOMAIN=chat.example.com
# Recommended: a name of its own for user files (point it at this server too), e.g.
# files.chat.example.com. It keeps uploaded content off the app's origin altogether; left empty,
# files are served from the main domain sandboxed (CSP sandbox + nosniff), which already keeps
# them from running as the app, but a separate origin is the stronger default.
FILES_DOMAIN=
# Optional: a name of its own for voice signalling (LiveKit).
VOICE_DOMAIN=
# Ports Caddy listens on; keep 80 and 443 unless another proxy sits in front.
HTTP_PORT=80
HTTPS_PORT=443
# Only with another proxy in front of Caddy (a CDN, a load balancer, nginx on the host): its
# addresses as CIDRs, space-separated, e.g. "10.0.0.0/8 2001:db8::/32". Caddy then takes the
# real client IP from X-Forwarded-For sent by those proxies (and only them); the server keeps
# trusting Caddy alone. Leave empty when clients connect to Caddy directly.
TRUSTED_PROXIES=

# Required secrets.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=chinchi
S3_SECRET_KEY=
# At least 32 characters.
LIVEKIT_API_SECRET=
# Encrypts files at rest. Keep a copy apart from backups of the data: without it the stored
# files can't be read back, and with it next to them the encryption protects nothing.
S3_KMS_MASTER_KEY=
# Encrypts two-factor (TOTP) secrets in the database (64 hex characters: openssl rand -hex 32).
# Keep it with S3_KMS_MASTER_KEY: without it, accounts with 2FA can't sign in.
SECRETS_KEY=

# Shown to users.
INSTANCE_NAME=Chinchi
# open | invite | closed — the default; instance admins can change it in the web admin panel.
REGISTRATION_MODE=open
# on | off — the default for the admin setting "require a confirmed email" before creating
# servers, accepting invites, messaging or adding friends. Recommended on for open registration.
REQUIRE_VERIFIED_EMAIL=on
# Required. Your email: registering with it makes you the instance admin (even with
# registration closed), as long as the instance has no admin yet.
INITIAL_ADMIN_EMAIL=

# Outgoing mail (email confirmation, password reset); without it emails are only logged.
# Example: smtp://user:password@smtp.example.com:587
SMTP_URL=
MAIL_FROM=Chinchi <no-reply@chat.example.com>
