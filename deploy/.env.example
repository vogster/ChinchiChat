# Settings for docker-compose.yml: save as .env next to it and fill in every value marked
# "required". Generate secrets with: openssl rand -base64 32

# The Chinchi release to run; upgrading is changing this and running `docker compose up -d`.
# Unset, the version the compose file was released with is used.
CHINCHI_VERSION=

# Required: the three DNS names pointing at this server (A/AAAA records).
CHINCHI_DOMAIN=chat.example.com
FILES_DOMAIN=files.chat.example.com
VOICE_DOMAIN=voice.chat.example.com
# Ports Caddy listens on; keep 80 and 443 unless another proxy sits in front.
HTTP_PORT=80
HTTPS_PORT=443

# Required secrets.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=chinchi
S3_SECRET_KEY=
# At least 32 characters.
LIVEKIT_API_SECRET=
# Encrypts files at rest. Keep a copy apart from backups of the data: without it the stored
# files can't be read back, and with it next to them the encryption protects nothing.
S3_KMS_MASTER_KEY=

# Shown to users.
INSTANCE_NAME=Chinchi
# open | invite | closed — the default; instance admins can change it in the web admin panel.
REGISTRATION_MODE=open
# Required. Your email: registering with it makes you the instance admin (even with
# registration closed), as long as the instance has no admin yet.
INITIAL_ADMIN_EMAIL=

# Outgoing mail (email confirmation, password reset); without it emails are only logged.
# Example: smtp://user:password@smtp.example.com:587
SMTP_URL=
MAIL_FROM=Chinchi <no-reply@chat.example.com>
