# CHINCHI_DOMAIN serves everything by default, with one automatic HTTPS certificate:
#   /          the web app        /api/*      the API and the realtime gateway
#   /chinchi/* stored files (the bucket's path-style presigned URLs, signed for this host)
#   /livekit/* LiveKit signalling (wss://); media itself goes over UDP straight to LiveKit
# FILES_DOMAIN and VOICE_DOMAIN, when set, move files or voice to names of their own instead.
# caddy-entrypoint.sh writes /etc/caddy/generated/*.caddy and FILES_ORIGIN / VOICE_ORIGIN from
# them before Caddy starts. Certificates come from Let's Encrypt (or a local CA for *.localhost).

(app_headers) {
	header {
		# The app ships no inline scripts.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' {$FILES_ORIGIN} data: blob:; media-src 'self' {$FILES_ORIGIN} blob:; connect-src 'self' {$FILES_ORIGIN} {$VOICE_ORIGIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		-Server
	}
}

# User content: never sniffed into HTML, never scripted (a sandboxed document has no origin, so
# not even a file served from the app's own domain can reach its cookies or API), never framed.
(files) {
	header {
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy no-referrer
		-Server
	}
	# The Host header passes through unchanged: presigned URLs are signed for it.
	reverse_proxy rustfs:9000
}

(voice) {
	reverse_proxy livekit:7880
}

{$CHINCHI_DOMAIN} {
	encode zstd gzip

	# Files and voice on this domain, unless they have names of their own.
	import /etc/caddy/generated/app.caddy

	handle {
		import app_headers

		# API and the realtime gateway (WebSocket upgrades pass through reverse_proxy).
		handle /api/* {
			reverse_proxy server:3000
		}
		handle /health {
			reverse_proxy server:3000
		}

		handle {
			root * /srv/web
			# Hashed assets never change; the app shell must always be fresh.
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			header /index.html Cache-Control "no-cache"
			# The service worker must update as soon as a new version is deployed.
			header /sw.js Cache-Control "no-cache"
			header /manifest.webmanifest Content-Type "application/manifest+json"
			try_files {path} /index.html
			file_server
		}
	}
}

import /etc/caddy/generated/sites.caddy
